# javelin scene file (.jvscene)
# schema=v1 units=m one-record-per-line key=value
# scene: wrecking pendulum vs layered brick wall (constraint + high-mass impact + debris field).
# wall: two-layer brick wall, 500 pieces, centered around pendulum impact zone.
# pendulum: bottom of swing (max speed) aligned to strike wall center height.
scene version=1 units=m

# physics_materials
physics_material id=1 restitution=0.05 friction=0.75 density=2.4
physics_material id=2 restitution=0.08 friction=0.35 density=2600

# shapes
shape id=brick kind=box hx=0.18 hy=0.12 hz=0.34
shape id=wrecking_ball kind=sphere r=1.35
shape id=anchor kind=sphere r=0.06

# static pendulum anchors
body id=pivot_f shape=anchor motion=static material=0 mesh=0 px=4.670000 py=11.800000 pz=-0.600000
body id=pivot_b shape=anchor motion=static material=0 mesh=0 px=4.670000 py=11.800000 pz=0.600000

# dynamic wrecking ball (released left of wall)
body id=ball shape=wrecking_ball motion=dynamic material=2 mesh=0 px=-3.699297 py=9.080650 pz=0.000000

