# javelin scene file (.jvscene)
# schema=v1 units=m one-record-per-line key=value
# scene: Pyramid topple XL  -  18-layer 3-D cube pyramid plus oversized wrecking sphere.
# Pyramid layers: 18..1 -> 2109 cubes total.
# Cube side=0.8 m, base span=14.4 m, peak height=14.4 m.
# Projectile: sphere r=3.0 launched diagonally from the left to shear through lower/mid layers.
scene version=1 units=m

# physics_materials
# id=1  stack cubes: grippy + low bounce for coherent stack behavior
# id=2  wrecking sphere: dense + low friction for high-momentum punch-through
physics_material id=1 restitution=0.25 friction=0.75 density=2.0
physics_material id=2 restitution=0.08 friction=0.2 density=1400

# shapes
shape id=cube kind=box hx=0.4 hy=0.4 hz=0.4
shape id=ball kind=sphere r=3.0

