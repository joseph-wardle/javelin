# javelin scene file (.jvscene)
# schema=v1 units=m one-record-per-line key=value
# scene: Newton's cradle XL - same overall stage size, only 5 much larger balls.
# frame bars are spaced wider in Z so the enlarged balls clear the top structure.
# balls start at rest geometry; ball_00 gets a much stronger +X velocity impulse for a wider/faster swing.
scene version=1 units=m

# physics_materials
# id=1 light alloy: near-elastic + low friction, reduced density for snappier response
physics_material id=1 restitution=0.995 friction=0.03 density=1800

# shapes
shape id=pivot kind=sphere r=0.02
shape id=ball kind=sphere r=1
shape id=frame_beam kind=box hx=5.4 hy=0.09 hz=0.09
shape id=frame_leg kind=box hx=0.09 hy=4.1 hz=0.09
shape id=frame_foot kind=box hx=0.55 hy=0.1 hz=0.65

# static frame
body id=frame_top_f shape=frame_beam motion=static material=0 mesh=0 px=0 py=8.2 pz=-1.4
body id=frame_top_b shape=frame_beam motion=static material=0 mesh=0 px=0 py=8.2 pz=1.4
body id=frame_leg_lf shape=frame_leg motion=static material=0 mesh=0 px=-5.1 py=4.1 pz=-1.4
body id=frame_leg_lb shape=frame_leg motion=static material=0 mesh=0 px=-5.1 py=4.1 pz=1.4
body id=frame_leg_rf shape=frame_leg motion=static material=0 mesh=0 px=5.1 py=4.1 pz=-1.4
body id=frame_leg_rb shape=frame_leg motion=static material=0 mesh=0 px=5.1 py=4.1 pz=1.4
body id=frame_foot_lf shape=frame_foot motion=static material=0 mesh=0 px=-5.1 py=0.1 pz=-1.4
body id=frame_foot_lb shape=frame_foot motion=static material=0 mesh=0 px=-5.1 py=0.1 pz=1.4
body id=frame_foot_rf shape=frame_foot motion=static material=0 mesh=0 px=5.1 py=0.1 pz=-1.4
body id=frame_foot_rb shape=frame_foot motion=static material=0 mesh=0 px=5.1 py=0.1 pz=1.4

# pivot bodies (static) and pendulum balls (dynamic)
body id=pivot_00f shape=pivot motion=static material=0 mesh=0 px=-4.2 py=8.2 pz=-1.4
body id=pivot_00b shape=pivot motion=static material=0 mesh=0 px=-4.2 py=8.2 pz=1.4
body id=ball_00 shape=ball motion=dynamic material=1 mesh=0 px=-4.2 py=3.2 pz=0 vx=11.8 vy=0 vz=0
body id=pivot_01f shape=pivot motion=static material=0 mesh=0 px=-2.1 py=8.2 pz=-1.4
body id=pivot_01b shape=pivot motion=static material=0 mesh=0 px=-2.1 py=8.2 pz=1.4
body id=ball_01 shape=ball motion=dynamic material=1 mesh=0 px=-2.1 py=3.2 pz=0
body id=pivot_02f shape=pivot motion=static material=0 mesh=0 px=0 py=8.2 pz=-1.4
body id=pivot_02b shape=pivot motion=static material=0 mesh=0 px=0 py=8.2 pz=1.4
body id=ball_02 shape=ball motion=dynamic material=1 mesh=0 px=0 py=3.2 pz=0
body id=pivot_03f shape=pivot motion=static material=0 mesh=0 px=2.1 py=8.2 pz=-1.4
body id=pivot_03b shape=pivot motion=static material=0 mesh=0 px=2.1 py=8.2 pz=1.4
body id=ball_03 shape=ball motion=dynamic material=1 mesh=0 px=2.1 py=3.2 pz=0
body id=pivot_04f shape=pivot motion=static material=0 mesh=0 px=4.2 py=8.2 pz=-1.4
body id=pivot_04b shape=pivot motion=static material=0 mesh=0 px=4.2 py=8.2 pz=1.4
body id=ball_04 shape=ball motion=dynamic material=1 mesh=0 px=4.2 py=3.2 pz=0

# constraints (dual rods per ball for planar stability)
constraint id=c_00f kind=distance body_a=pivot_00f body_b=ball_00 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_00b kind=distance body_a=pivot_00b body_b=ball_00 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_01f kind=distance body_a=pivot_01f body_b=ball_01 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_01b kind=distance body_a=pivot_01b body_b=ball_01 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_02f kind=distance body_a=pivot_02f body_b=ball_02 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_02b kind=distance body_a=pivot_02b body_b=ball_02 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_03f kind=distance body_a=pivot_03f body_b=ball_03 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_03b kind=distance body_a=pivot_03b body_b=ball_03 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_04f kind=distance body_a=pivot_04f body_b=ball_04 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
constraint id=c_04b kind=distance body_a=pivot_04b body_b=ball_04 ax=0 ay=0 az=0 bx=0 by=0 bz=0 rest=5.19230199 compliance=0
