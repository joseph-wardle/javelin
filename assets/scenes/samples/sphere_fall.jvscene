# javelin scene file (.jvscene)
# schema=v1 units=m one-record-per-line key=value
# scene: one dynamic sphere falling onto the implicit ground plane
scene version=1 units=m

# physics_materials
# id=1  rubber: high bounce, high grip — models a rubber ball
physics_material id=1 restitution=0.8 friction=0.8

# shapes
shape id=sphere kind=sphere r=0.5

# bodies
body id=sphere_fall shape=sphere motion=dynamic material=1 mesh=0 px=0 py=8 pz=0
